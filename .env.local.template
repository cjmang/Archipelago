# Used in justfile, either copy this yourself to .env.local or let ´just setup´ do it for you.
# If you want to temporarily overwrite any variables, you can also just set them when calling `just`:
# SEED="MYCOOLSEED" just start-server

# TODO: Test if ~/ works
# TODO: Quotes by default? Add a comment somewhere? if windows users type in C:\Something, the backslash counts as escaping
# TODO: Add a "required" and "optional" section?

# Your archipelago checkout, this will get linked to external/archipelago
#ARCHIPELAGO_ROOT=../../archipelago

# Some constant seed to make generating a world deterministic (mostly for tests)
#SEED=1

# What port the server should start on
#LOCAL_SERVER_PORT=38281

# Path to your EmuHawk executable (EmuHawk.exe on Windows, EmuHawkMono.sh on linux/unix)
# TODO: not happy about the default here. Since bizhawk is just a zip/tar, it's very different on where it's saved.
#       Probably make a proper "setup" step before?
#EMUHAWK=../../tools/bizhawk/EmuHawk.exe

# Lua connector passed to EmuHawk with --lua=
# Can only be one. If we need more, might need to introduce a BIZHAWK_WATCHES env variable.
# TODO: WSL stuff
#CONNECTOR_LUA=external/archipelago/data/lua/connector_bizhawk_generic.lua

# Path to the unpatched ROM that `just patch` uses to generate the GSTLA_PATCHED_ROM.
# If it's commented out, it defaults to the "gstla_options.rom_file" settings from the host.yaml in your AP checkout
#GSTLA_VANILLA_ROM=


# TODO: add a WSL=True compatibility option or something?
# GSTLA_PATCHED_ROM and CONNECTOR_LUA is passed to the BizHawk executable, so those need the Windows-style path.
# Could then also probably remove the GSTLA_PATCHED_ROM in general, I think.

# Path to the patched ROM that is then passed to EmuHawk.
# You very likely do not need this. All patched ROMs after generation will be put in .ap/, anyway.
# TODO: WSL stuff
#GSTLA_PATCHED_ROM=.ap/out/AP_1_P1_Player.gba
